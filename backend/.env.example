# Server
PORT=3000

# ============================================================
# Base de datos
# Opción A (producción): URL completa. Se usa si DB_HOST no está definido.
# ============================================================
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================================
# Opción B (desarrollo local): parámetros individuales.
# Si DB_HOST está definido, tiene prioridad sobre DATABASE_URL.
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-en-local
DB_NAME=finance_manager
DB_SSL=false

# ============================================================
# Auth
# ============================================================
JWT_SECRET=cambiar-este-secreto-largo-y-aleatorio

# ============================================================
# Email - Gmail API (OAuth2)
# ============================================================
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
EMAIL_USER=
EMAIL_PASSWORD=
