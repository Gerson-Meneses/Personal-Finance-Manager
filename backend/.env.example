# Server
PORT=3000
# Origenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# Rate limit de auth (ventana ms / max requests)
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=30

# ============================================================
# Base de datos
# Opción A (producción): URL completa. Tiene prioridad sobre DB_HOST.
# ============================================================
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================================
# Opción B (desarrollo local): parámetros individuales.
# Si DATABASE_URL no está definido, se usan DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-en-local
DB_NAME=finance_manager
DB_SSL=false

# ============================================================
# Auth
# ============================================================
JWT_SECRET=cambiar-este-secreto-largo-y-aleatorio

# ============================================================
# Email - Gmail API (OAuth2)
# ============================================================
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
EMAIL_USER=
EMAIL_PASSWORD=
