{
    "name": "backend",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "tsc",
        "start": "bun node_modules/typeorm/cli.js migration:run -d dist/database/dataBaseDev.js && bun run dist/index.js",
        "db:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/database/dataBaseDev.ts",
        "db:migrate": "bun node_modules/typeorm/cli.js migration:run -d src/database/dataBaseDev.ts",
        "db:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/database/dataBaseDev.ts",
        "db:show": "bun node_modules/typeorm/cli.js migration:show -d src/database/dataBaseDev.ts",
        "db:baseline": "bun src/database/baseline.ts",
        "test": "bun test"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.7.6",
        "@types/morgan": "^1.9.10",
        "colord": "^2.9.3",
        "dayjs": "^1.11.20",
        "dotenv": "^17.3.1",
        "googleapis": "^171.4.0",
        "hono": "^4.12.15",
        "morgan": "^1.10.1",
        "nodemailer": "^8.0.5",
        "pg": "^8.16.3",
        "typeorm": "^0.3.28",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bun": "^1.3.11",
        "@types/node": "^25.0.3",
        "@types/nodemailer": "^8.0.0",
        "typescript": "^5.9.3"
    }
}
